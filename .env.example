# Default evidence mode is fully local and does not require an API key.
LLM_PROVIDER=offline

# Optional Groq enhancement. Never commit the real key.
# LLM_PROVIDER=groq
# GROQ_API_KEY=replace_me
# GROQ_MODEL=openai/gpt-oss-20b

CHECKPOINT_DB=/app/evidence/checkpoints.sqlite
LOG_FILE=/app/evidence/execution_log.jsonl
METRICS_FILE=/app/evidence/metrics.prom
ARTIFACT_DIR=/app/evidence/artifacts
POLICY_DIR=/app/data/policies

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=contractguard
MINIO_SECRET_KEY=replace_with_a_strong_secret
MINIO_SECURE=false
MINIO_BUCKET=contractguard-reports

APPROVAL_RISK_THRESHOLD=50
APPROVAL_VALUE_THRESHOLD_SAR=500000
MAX_POLICY_RETRIES=2
MAX_QUALITY_RETRIES=1
MAX_REPORT_REVISIONS=2
MAX_GRAPH_STEPS=60
