# Copy to .env for local development. python-dotenv loads it automatically; real
# process/container environment variables take precedence. Never commit the copied file.
# Reproducible default: schema-aware MCP-style tool routing, no external secret.
LLM_PROVIDER=offline
LLM_TIMEOUT_SECONDS=45

# Optional live model-native function calling. Enable exactly one provider.
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=replace_me
# GEMINI_MODEL=gemini-2.5-flash

# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=replace_me
# OPENROUTER_MODEL=google/gemini-2.5-flash
# OPENROUTER_SITE_URL=https://github.com/Adwd23/contractguard-ai

# LLM_PROVIDER=groq
# GROQ_API_KEY=replace_me
# GROQ_MODEL=openai/gpt-oss-20b

# Optional API authentication. When set, /audits endpoints require X-API-Key.
# CONTRACTGUARD_API_KEY=replace_with_a_long_random_value

CHECKPOINT_DB=/app/evidence/checkpoints.sqlite
LOG_FILE=/app/evidence/execution_log.jsonl
METRICS_FILE=/app/evidence/metrics.prom
ARTIFACT_DIR=/app/evidence/artifacts
POLICY_DIR=/app/data/policies
CONTRACT_ALLOWED_ROOTS=/app/data

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=contractguard
MINIO_SECRET_KEY=replace_with_a_strong_secret
MINIO_SECURE=false
MINIO_BUCKET=contractguard-reports
MINIO_ROOT_USER=contractguard
MINIO_ROOT_PASSWORD=replace_with_a_strong_secret

APPROVAL_RISK_THRESHOLD=50
APPROVAL_VALUE_THRESHOLD_SAR=500000
MAX_POLICY_RETRIES=2
MAX_QUALITY_RETRIES=1
MAX_REPORT_REVISIONS=2
MAX_GRAPH_STEPS=60
